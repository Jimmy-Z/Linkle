{
	"manifest_version": 3,
	"name": "Linkle",
	"version": "0.4.0",
	"description": "Send link to aria2/qBittorrent RPC",
	"homepage_url": "https://github.com/Jimmy-Z/Linkle",
	"icons": {
		"64": "icon.png"
	},
	"background": {
		"service_worker": "linkle.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"permissions": [
		"contextMenus",
		"notifications",
		"storage",
		"downloads"
	],
	"optional_permissions": ["cookies"],
	"optional_host_permissions": ["*://*/"]
}
