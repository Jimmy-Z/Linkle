{
	"manifest_version": 3,
	"name": "Linkle",
	"version": "0.3.1",
	"description": "Send link to aria2/qBittorrent RPC",
	"homepage_url": "https://github.com/Jimmy-Z/Linkle",
	"icons": {
		"64": "icon.png"
	},
	"background": {
		"service_worker": "linkle.js",
		"type": "module"
	},
	"options_ui": {
		"page": "options.html"
	},
	"permissions": [
		"contextMenus",
		"notifications",
		"storage",
		"scripting",
		"activeTab"
	],
	"optional_permissions": ["cookies"],
	"optional_host_permissions": ["http://*/", "https://*/"]
}
